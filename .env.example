# --- database ---------------------------------------------------------------
# SQLite for local development. Point at Postgres in production and change the
# provider in prisma/schema.prisma to match.
DATABASE_URL="file:./dev.db"

# --- site -------------------------------------------------------------------
# Absolute origin. Used for canonical URLs, the sitemap, RSS, CSV export links
# and every link inside an email. Get this wrong and the emails point nowhere.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- email ------------------------------------------------------------------
# outbox       queue only, never send (default — works with no credentials)
# console      queue and print to the server log, useful in development
# onchainsuite queue and POST to the OnchainSuite API (see lib/email/provider.ts)
EMAIL_PROVIDER="outbox"
EMAIL_FROM="West Midlands Startup Map <hello@example.com>"

# Where intro requests are forwarded. Unset means they queue but go nowhere.
ADMIN_EMAIL=""

# OnchainSuite transport. The request shape in lib/email/provider.ts is a
# placeholder — confirm the endpoint, auth header and body before switching over.
ONCHAINSUITE_API_URL=""
ONCHAINSUITE_API_KEY=""

# --- admin ------------------------------------------------------------------
# One shared token guarding /admin. Without it, /admin refuses to open at all.
ADMIN_TOKEN=""

# --- cron -------------------------------------------------------------------
# Bearer token for /api/cron/digest. Without it the route returns 503.
CRON_SECRET=""
